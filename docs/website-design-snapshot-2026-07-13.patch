+/** Scroll progress 0→1 over the first `max` pixels (drives the logo hand-off). */
+function useScrollProgress(max = 300) {
+  const [p, setP] = useState(0);
+  useEffect(() => {
+    const on = () => setP(Math.min(1, Math.max(0, window.scrollY / max)));
+    on();
+    window.addEventListener("scroll", on, { passive: true });
+    return () => window.removeEventListener("scroll", on);
+  }, [max]);
+  return p;
+}
+
+/** Track which nav section is currently in view (for the header underline). */
+function useActiveSection(items: readonly { href: string }[]) {
+  const [active, setActive] = useState(items[0]?.href ?? "");
+  useEffect(() => {
+    const onScroll = () => {
+      const line = window.scrollY + window.innerHeight * 0.32;
+      let cur = items[0]?.href ?? "", best = -Infinity;
+      for (const it of items) {
+        const el = document.getElementById(it.href.slice(1));
+        if (!el) continue;
+        const top = el.offsetTop;
+        if (top <= line && top >= best) { best = top; cur = it.href; }
+      }
+      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
+        cur = items[items.length - 1].href;
+      }
+      setActive(cur);
+    };
+    onScroll();
+    window.addEventListener("scroll", onScroll, { passive: true });
+    window.addEventListener("resize", onScroll);
+    return () => { window.removeEventListener("scroll", onScroll); window.removeEventListener("resize", onScroll); };
+  }, [items]);
+  return active;
+}
+
+/** Stagger-reveal common blocks as they scroll into view. */
+function useReveal() {
+  useEffect(() => {
+    if (window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) return;
+    const groups = [
+      ".section-heading", ".step", ".shot", ".privacy-head", ".privacy-item",
+      ".strip-card", ".security-card", ".bench-metric", ".versus", ".bench-table",
+      ".bench-notes p", ".faq-aside", ".faq-list details", ".download-card", ".limitations-card",
+    ];
+    const io = new IntersectionObserver(
+      entries => entries.forEach(e => {
+        if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
+      }),
+      { threshold: 0.12, rootMargin: "0px 0px -7% 0px" },
+    );
+    for (const sel of groups) {
+      document.querySelectorAll<HTMLElement>(sel).forEach((el, i) => {
+        el.classList.add("reveal");
+        el.style.transitionDelay = `${Math.min(i, 6) * 70}ms`;
+        io.observe(el);
+      });
+    }
+    return () => io.disconnect();
+  }, []);
+}
 
