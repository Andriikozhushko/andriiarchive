+        </div>
+        <nav className="footer-links" aria-label="Ссылки">
+          <a href={benchmarkDocsUrl} target="_blank" rel="noreferrer">Документация</a>
+          <a href={release.repoUrl} target="_blank" rel="noreferrer">GitHub</a>
+          <a href="#security-intro">Политика конфиденциальности</a>
+          <a href={release.repoUrl} target="_blank" rel="noreferrer">Лицензия</a>
+        </nav>
+        <div className="footer-social" aria-label="Платформы">
+          <IconWindowsGlyph size={18} />
+          <IconTuxGlyph size={18} />
+          <a href={release.repoUrl} target="_blank" rel="noreferrer" aria-label="GitHub"><IconGithub size={18} /></a>
+        </div>
+      </div>
+    </footer>
+  );
+}
+
+/* ------------------------------------------------------------- Shared bits */
+
+function SectionHeading({ title, lead }: { title: string; lead?: string }) {
